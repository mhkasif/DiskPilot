{
  "name": "diskpilot",
  "productName": "DiskPilot",
  "version": "2.1.0",
  "description": "DiskPilot – Disk Space Analyzer (TreeSize clone)",
  "author": {
    "name": "mhkasif",
    "email": "mhkasif97@gmail.com"
  },
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron_config_cache=/tmp/electron-cache electron .",
    "start:win": "set electron_config_cache=C:\\Temp\\electron-cache&& electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.diskpilot.app",
    "productName": "DiskPilot",
    "copyright": "Copyright © 2025 DiskPilot Contributors",
    "publish": {
      "provider": "github",
      "owner": "mhkasif",
      "repo": "DiskPilot"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "INSTALL_GUIDE.md",
        "to": ".",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "icon": "assets/playstore.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" },
        { "x": 270, "y": 220, "type": "file", "path": "INSTALL_GUIDE.md" }
      ]
    },
    "win": {
      "icon": "assets/playstore.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ]
    },
    "linux": {
      "icon": "assets/playstore.png",
      "category": "Utility",
      "target": ["AppImage", "deb", "zip"]
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
